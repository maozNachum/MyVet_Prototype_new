# Frontend-safe Supabase configuration only.
# Copy this file to .env and replace the placeholders locally.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Do not add GEMINI_API_KEY, service_role, database passwords or other secrets here.
# Server-only values belong in Supabase Edge Function Secrets.
