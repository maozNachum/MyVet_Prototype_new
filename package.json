{
  "name": "myvet-system",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck:ai": "tsc -p tsconfig.ai-infrastructure.json",
    "typecheck:edge": "deno check --frozen supabase/functions/ai-assistant/index.ts supabase/functions/visit-summary/index.ts supabase/functions/digitalcare-transcription/index.ts supabase/functions/medical-record-rag/index.ts supabase/functions/document-ocr/index.ts supabase/functions/client-summary/index.ts supabase/functions/follow-up-suggestions/index.ts",
    "test:privacy": "node --experimental-strip-types --test --test-concurrency=1 tests/aiPrivacy.test.ts tests/privacyRightsSecurity.test.ts tests/privacyRightsDatabaseIntegration.test.mjs",
    "test:ai-infrastructure": "node --experimental-strip-types --test tests/aiGatewayInfrastructure.test.ts",
    "test:frontend-secrets": "node scripts/verify-frontend-ai-secrets.mjs",
    "test:ai-data-security": "node --experimental-strip-types --test tests/aiStage2DatabaseSecurity.test.ts",
    "test:ai-data-local": "node --test tests/aiStage2DatabaseIntegration.test.mjs",
    "test:ai-data-integration": "node scripts/verify-ai-stage2-rls.mjs",
    "test:visit-summary": "node --experimental-strip-types --test tests/visitSummarySecurity.test.ts tests/aiGatewayInfrastructure.test.ts tests/aiStage2DatabaseIntegration.test.mjs",
    "test:digitalcare-ai": "node --experimental-strip-types --test tests/digitalCareAiSecurity.test.ts tests/aiGatewayInfrastructure.test.ts tests/aiStage2DatabaseIntegration.test.mjs",
    "test:rag-ai": "node --experimental-strip-types --test tests/ragSecurity.test.ts",
    "test:document-ocr": "node --experimental-strip-types --test tests/documentOcrSecurity.test.ts",
    "test:appointments": "node --experimental-strip-types --test tests/appointmentMutationsSecurity.test.ts tests/appointmentMutationsDatabaseIntegration.test.mjs",
    "test:medical-visits": "node --experimental-strip-types --test tests/medicalVisitMutationsSecurity.test.ts tests/medicalVisitMutationsDatabaseIntegration.test.mjs",
    "test:owner-profile-claim": "node --experimental-strip-types --test tests/ownerProfileClaimSecurity.test.ts tests/ownerProfileClaimDatabaseIntegration.test.mjs",
    "test:client-summary": "node --experimental-strip-types --test tests/clientSummarySecurity.test.ts tests/aiStage2DatabaseIntegration.test.mjs",
    "test:follow-up-suggestions": "node --experimental-strip-types --test tests/followUpSuggestionsSecurity.test.ts tests/aiStage2DatabaseIntegration.test.mjs",
    "test:hardening": "node --experimental-strip-types --test tests/finalHardening.test.ts",
    "test:auth-hardening": "node --experimental-strip-types --test tests/authHardening.test.ts",
    "test:auth-lifecycle-local": "node scripts/verify-auth-lifecycle.mjs",
    "test:multi-clinic-onboarding-preview": "node scripts/verify-multi-clinic-onboarding.mjs",
    "test:accessibility": "node --experimental-strip-types --test tests/accessibilityFoundation.test.ts",
    "test:rag-calibration": "node --experimental-strip-types scripts/calibrate-rag-similarity.mjs",
    "test:vetbot": "node scripts/run-vetbot-tests.mjs",
    "test:anon-access": "node scripts/verify-anonymous-access.mjs",
    "test:supabase-baseline": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/supabase-baseline/verify-local.ps1"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "0.487.0",
    "next-themes": "0.4.6",
    "react-hook-form": "^7.71.2",
    "react-router": "^7.18.2",
    "sonner": "^2.0.3",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "^7.0.2",
    "vite": "6.4.3"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  }
}
